# DocVault — runtime configuration template (no real value here; copy to .env, which Git ignores).
# Secrets are read from mounted files (NAME_FILE) in Compose and Kubernetes.
# A plain NAME=value variable also works for local development, but is visible in `docker inspect`.

# AES-256 master key: 64 hexadecimal characters, generated with `openssl rand -hex 32`.
DOCVAULT_MASTER_KEY_FILE=./secrets/docvault_master_key
DOCVAULT_MASTER_KEY_VERSION=v1
