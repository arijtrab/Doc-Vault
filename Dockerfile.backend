# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
ARG RUNTIME_IMAGE=gcr.io/distroless/nodejs22-debian13:nonroot@sha256:c73ddeb03e1dc2d579aa111c83d6699c6b8b487e35c0c631d4a3a20229fc25ee
FROM ${NODE_IMAGE} AS build
WORKDIR /src
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY backend ./backend
COPY database ./database
COPY security ./security
RUN ./node_modules/.bin/esbuild backend/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=/out/server.js

FROM ${NODE_IMAGE} AS runtime-deps
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY docker/backend-runtime/package.json ./package.json
COPY docker/backend-runtime/package-lock.json ./package-lock.json
RUN npm ci --omit=dev --no-audit --no-fund \
  && npm cache clean --force \
  && mkdir -p /data \
  && chown 65532:65532 /data

FROM ${RUNTIME_IMAGE} AS runtime
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0 \
    DOCVAULT_DOCKER_LAB=true \
    DOCVAULT_DB_PATH=/data/docvault.db
WORKDIR /app
COPY --from=runtime-deps --chown=65532:65532 /app/node_modules ./node_modules
COPY --from=runtime-deps --chown=65532:65532 /data /data
COPY --from=build --chown=65532:65532 /out/server.js ./server.js
USER 65532:65532
EXPOSE 3001
CMD ["server.js"]
