# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
FROM ${NODE_IMAGE} AS build
WORKDIR /src
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx/nginx-unprivileged:1.30.8-alpine3.24@sha256:637c35e46af7bc0dd3d3bcf7162e004e13ab3b370fde7cd416e2ac410b5a985a AS runtime
# Temporary exception (27/11/2026): the pinned base ships libxml2 2.13.9-r3 with six HIGH CVEs
# (CVE-2026-11979, CVE-2026-86138/86139/86140/86142/86143), fixed in 2.13.9-r5.
# Upgrade only this package until upstream publishes a fixed base image, then remove these lines
# and pin the new digest. root is used only at build time; the runtime user stays 101.
USER root
RUN apk upgrade --no-cache libxml2
USER 101
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/ /usr/share/nginx/html/
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
